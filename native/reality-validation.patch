+// NOVA addition: validate without opening listeners or taking a TUN descriptor.
+// No raw config errors cross the FFI boundary (they can contain credentials).
+#[no_mangle]
+pub unsafe extern "C" fn rc_validate(
+    config: *const std::os::raw::c_char,
+    directory: *const std::os::raw::c_char,
+) -> i32 {
+    std::panic::catch_unwind(|| {
+        let Some(text) = (unsafe { arg(config) }).ok().flatten() else { return 0; };
+        let Some(dir) = (unsafe { arg(directory) }).ok().flatten() else { return 0; };
+        let runtime = match tokio::runtime::Builder::new_current_thread().enable_all().build() {
+            Ok(rt) => rt, Err(_) => return 0,
+        };
+        runtime.block_on(async {
+            let Ok(cfg) = parse_config(text, std::path::Path::new(dir), None) else { return 0; };
+            i32::from(App::build(&cfg).is_ok())
+        })
+    }).unwrap_or(0)
+}
