+async fn lookup_both<F>(preferred: F, alternate: F) -> Result<Vec<IpAddr>>
+where
+    F: Future<Output = Result<Vec<IpAddr>>>,
+{
+    tokio::pin!(preferred, alternate);
+    let (first, pending, preferred_first) = tokio::select! {
+        biased;
+        result = &mut preferred => (result, alternate, true),
+        result = &mut alternate => (result, preferred, false),
+    };
+    let second = if first.as_ref().is_ok_and(|addresses| !addresses.is_empty()) {
+        match tokio::time::timeout(ADDRESS_FAMILY_GRACE, pending).await {
+            Ok(result) => result,
+            Err(_) => return first,
+        }
+    } else {
+        pending.await
+    };
+    let (preferred, alternate) = if preferred_first {
+        (first, second)
+    } else {
+        (second, first)
+    };
+    match (preferred, alternate) {
+        (Ok(mut addresses), Ok(alternate)) => {
+            addresses.extend(alternate);
+            Ok(addresses)
+        }
+        (Ok(addresses), Err(_)) | (Err(_), Ok(addresses)) if !addresses.is_empty() => Ok(addresses),
+        (Err(error), _) | (_, Err(error)) => Err(error),
+    }
+}
