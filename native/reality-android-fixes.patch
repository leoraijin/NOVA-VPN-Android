+/// Poll core health without blocking; a failure remains false until restart.
+/// NULL returns 0. Serialize with all other calls using this handle.
+///
+/// # Safety
+/// `core` must be a live handle from rc_start, exclusively borrowed for this call.
+#[no_mangle]
+pub unsafe extern "C" fn rc_is_alive(core: *mut RcCore) -> c_int {
+    catch_unwind(AssertUnwindSafe(|| {
+        let Some(core) = (unsafe { core.as_mut() }) else {
+            return 0;
+        };
+        c_int::from(core.running.as_mut().is_some_and(Running::is_alive))
+    }))
+    .unwrap_or(0)
+}
